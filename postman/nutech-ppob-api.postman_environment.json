{
  "id": "nutech-ppob-env-local",
  "name": "SIMS PPOB API – Local",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "default",
      "enabled": true,
      "description": "Base URL server. Ganti ke URL Railway/deploy kalau sudah production."
    },
    {
      "key": "token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "JWT Bearer token. Terisi otomatis setelah request Login berhasil."
    },
    {
      "key": "balance",
      "value": "0",
      "type": "default",
      "enabled": true,
      "description": "Saldo terakhir user. Terupdate otomatis setelah Top Up."
    }
  ],
  "_postman_variable_scope": "environment",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
}
